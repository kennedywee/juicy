#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
deps_root="${project_dir}/.deps/root"

cmake_bin="${deps_root}/usr/bin/cmake"
ninja_bin="${deps_root}/usr/bin/ninja"

if [[ ! -x "${cmake_bin}" ]]; then
  cmake_bin="$(command -v cmake)"
fi

if [[ ! -x "${ninja_bin}" ]]; then
  ninja_bin="$(command -v ninja)"
fi

if [[ -d "${deps_root}/usr/lib" ]]; then
  export LD_LIBRARY_PATH="${deps_root}/usr/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
fi

exec "${cmake_bin}" \
  -S "${project_dir}" \
  -B "${project_dir}/build" \
  -G Ninja \
  -DCMAKE_BUILD_TYPE=Debug \
  -DCMAKE_MAKE_PROGRAM="${ninja_bin}" \
  -DJUICY_DEPS_ROOT="${deps_root}"

