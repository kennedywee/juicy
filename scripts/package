#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
deps_root="${project_dir}/.deps/root"
cmake_bin="${deps_root}/usr/bin/cmake"
release_dir="${project_dir}/build-release"
package_root="${release_dir}/package-root"
archive="${project_dir}/build/juicy-linux-x86_64.tar.zst"
ninja_bin="${deps_root}/usr/bin/ninja"

if [[ ! -x "${cmake_bin}" ]]; then
  cmake_bin="$(command -v cmake)"
fi

if [[ ! -x "${ninja_bin}" ]]; then
  ninja_bin="$(command -v ninja)"
fi

if [[ -d "${deps_root}/usr/lib" ]]; then
  export LD_LIBRARY_PATH="${deps_root}/usr/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
fi

"${cmake_bin}" \
  -S "${project_dir}" \
  -B "${release_dir}" \
  -G Ninja \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_MAKE_PROGRAM="${ninja_bin}" \
  -DJUICY_DEPS_ROOT="${deps_root}"
"${cmake_bin}" --build "${release_dir}"
"${cmake_bin}" -E rm -rf "${package_root}"
"${cmake_bin}" -E make_directory "${project_dir}/build"
DESTDIR="${package_root}" "${cmake_bin}" \
  --install "${release_dir}" \
  --prefix /usr
tar --zstd -cf "${archive}" -C "${package_root}" .
"${cmake_bin}" -E rm -rf "${package_root}"

echo "${archive}"
